{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "policai",
	"main": "worker.mjs",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS",
		// worker.mjs answers /_bundled/ with a 404 and strips /_rsc/; see there.
		"run_worker_first": ["/_bundled/*", "/_rsc/*"]
	},
	// OpenNext resizes /_next/image requests through this binding.
	"images": {
		"binding": "IMAGES"
	},
	// policai.org serves from this Worker. The tunnel CNAMEs stay in the zone
	// as the rollback: delete these routes and the tunnel answers again.
	"routes": [
		{ "pattern": "policai.org/*", "zone_name": "policai.org" },
		{ "pattern": "www.policai.org/*", "zone_name": "policai.org" }
	],
	// Nightly rebuild at 00:05 Sydney time; worker.mjs picks the cron that
	// matches daylight saving.
	"triggers": {
		"crons": ["5 13 * * *", "5 14 * * *"]
	},
	// Per-client request budgets for the API routes, shared by every isolate
	// in a Cloudflare location. Each must match its RateLimitConfig in code
	// (src/lib/rate-limit.test.ts checks). namespace_id is any account-unique
	// integer.
	"ratelimits": [
		{ "name": "RATE_LIMIT_PUBLIC_API", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
		{ "name": "RATE_LIMIT_SIGNAL_REVIEWS", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
		{ "name": "RATE_LIMIT_SIGNAL_REVIEW", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } },
		{ "name": "RATE_LIMIT_APPROVALS", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } }
	],
	// Off so the Signal write API answers only on policai.org.
	"workers_dev": false
}
