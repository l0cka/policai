  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/bundle-publish-shims.mjs && node scripts/copy-extension-assets.mjs && pnpm run build:playground && pnpm run docs:build",
    "build:dist": "node scripts/build-hosted-dist.mjs",
    "postinstall": "node -e \"const fs=require('fs'),cp=require('child_process'),run=(p)=>cp.execFileSync(process.execPath,[p],{stdio:'inherit'});if(fs.existsSync('./scripts/build-hosted-dist.mjs'))run('./scripts/build-hosted-dist.mjs');try{const p='./scripts/install-cursor-skills.mjs';if(fs.existsSync(p))run(p)}catch{}\"",
    "build:playground": "vite build --config playground/vite.config.ts",
    "build:playground:central": "vite build --mode central --config playground/vite.config.ts",
    "dev:playground": "vite --config playground/vite.config.ts",
    "api:report": "node scripts/api-report.mjs",
    "check": "oxlint src && tsc --noEmit && tsc --noEmit -p playground/tsconfig.json",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:verify-links": "node scripts/verify-docs-links.mjs",
    "fix": "oxlint --fix src && oxfmt --write --no-error-on-unmatched-pattern src",
    "test": "vitest run --passWithNoTests",
    "type-check": "tsc --noEmit && tsc --noEmit -p playground/tsconfig.json",
    "build-dev": "echo noop",
    "build-types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "verify-publish": "node scripts/verify-publish-artifacts.mjs",
    "smoke-publish": "node scripts/smoke-publish-artifact.mjs",
    "publish-check": "pnpm run build && pnpm run verify-publish && pnpm run smoke-publish"
  }
