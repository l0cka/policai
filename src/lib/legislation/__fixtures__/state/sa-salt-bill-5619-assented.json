[{"billID":5619,"billNumber":3,"originalBillNumber":0,"version":"","sessionOfParliamentID":182,"sessionOfParliament":"56th/1st","parliament":56,"session":1,"houseID":1,"abbreviatedHouse":"HA","fullHouse":"House of Assembly","billTypeID":1,"abbreviatedBillType":"GOV","fullBillType":"Government Bill","title":"Petroleum Products Regulation (Emergencies and Other Matters) Amendment","statusText":"Assented","introducedIn":null,"dateIntroduced":"2026-05-06T00:00:00","introducedBy":"Energy and Mining (Hon A Koutsantonis)","dateMoved":"2026-05-06T00:00:00","dateOfSecondReading":"2026-05-20T00:00:00","dateOfThirdReading":null,"movedBy":"Energy and Mining (Hon A Koutsantonis)","dateCompleted":"2026-06-11T00:00:00","adjournedBy":"Mr Teague","remarks":"","actNumber":1,"yearOfAct":2026,"precis":"<p><span style=\"color:#444444;\">This Act amends the </span><em><span style=\"color:#444444;\">Petroleum Products Regulation</span></em><span style=\"color:#444444;\"> Act </span><em><span style=\"color:#444444;\">1995</span></em><span style=\"color:#444444;\"> to update South Australia’s legislative framework for regulating petroleum products during an emergency consistent with the Commonwealth Government’s framework.</span></p><p style=\"text-align:justify\"><span style=\"color:#444444;\">The Act will provide the Governor the ability to declare an initial period of rationing for a maximum of ninety days, an increase from the current maximum of seven days. The Governor will then have the power to extend the proclamation for a further ninety days and for as many subsequent periods as necessary, supporting consistent declaration periods and providing greater confidence for cross-border arrangements.</span></p>","lookupStatusID":28,"thirdReadingMovedBy":"Minister for Energy and Mining (Hon A Koutsantonis)","thirdReadingDate":"2026-05-20T00:00:00","originHouse":null,"referenceType":0,"hansardDate":"0001-01-01T00:00:00","hansardPage":null,"recommendedClause":null,"finalStatusDate":null,"oth