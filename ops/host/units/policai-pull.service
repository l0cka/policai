[Unit]
Description=Deploy separate Policai and Pro Bono releases through guarded host dispatcher
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/libexec/policai-deploy
TimeoutStartSec=90min
Nice=10
UMask=0027
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
RuntimeDirectory=policai-deploy-observation
RuntimeDirectoryMode=0755
BindReadOnlyPaths=/home/l0cka/.config/systemd/user:/run/policai-deploy-observation/user-units
