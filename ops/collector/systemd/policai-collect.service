[Unit]
Description=Policai collection run
After=network-online.target
OnFailure=policai-collect-alert.service

[Service]
Type=oneshot
ExecStart=%h/.local/bin/policai-collect.sh
Environment=USE_CLEF_CLASSIFIER=1
Environment=POLICAI_CHROMIUM_PATH=/usr/bin/chromium
UnsetEnvironment=DBUS_SESSION_BUS_ADDRESS
Nice=15
TimeoutStartSec=3600
# Runs peak at 2.1 to 2.6 GB; the ceiling stops a runaway browser taking the host.
MemoryMax=4G
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
TemporaryFileSystem=%h:ro %t:ro
TemporaryFileSystem=%h/.config/chromium %h/.cache/chromium
InaccessiblePaths=-/mnt -/run/docker.sock
BindReadOnlyPaths=%h/.local/bin/policai-collect.sh %h/.local/share/policai
BindReadOnlyPaths=%h/.local/share/mise %h/.config/mise %h/.config/git %h/.config/gh
BindPaths=%h/.local/share/mise/command-wrappers/bin.lock -%h/.cache/mise -%h/.local/state/mise
BindPaths=%h/Work/Argus/live/policai-collector %h/Work/Argus/src/policai-collector-work
BindPaths=%h/.local/state/argus-jobs %h/.npm
