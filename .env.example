# Policai Signal HTTPS API (product path for the Grok Bot). Set on the
# Argus-hosted Next.js process. The bot holds the same value via a masked
# prompt as POLICAI_SIGNAL_TOKEN — never commit the value.
POLICAI_SIGNAL_TOKEN=

# Host-only GitHub token. Signal POST reads main through it, decides against
# that snapshot and commits only the changed files as a PR (default) or a push
# to main; it never writes the checkout. Required for POST (503 without it).
# Needs outbound HTTPS to api.github.com. Never give this to the bot.
POLICAI_SIGNAL_GITHUB_TOKEN=

# pr (default) | main — Dan merges PRs unless main is opted in.
POLICAI_SIGNAL_COMMIT_TARGET=

# Optional owner/repo for Signal persistence (default l0cka/policai).
POLICAI_SIGNAL_GITHUB_REPO=

# Comma-separated allowlist for Signal approve / dismiss.
# Default when unset: Daniel Alkurdi,Daniel
POLICAI_SIGNAL_REVIEWERS=

# Local-only MCP source-ingest writes (laptop recovery; not the Signal bot path).
POLICAI_MCP_ADMIN_TOKEN=

# Register-audit retrieval (scripts/audit-register.ts). Defaults: 45s per
# attempt, exactly one retry (2 attempts), 1s backoff. Client errors such as
# HTTP 403 are never retried.
AUDIT_REGISTER_TIMEOUT_MS=
AUDIT_REGISTER_ATTEMPTS=
AUDIT_REGISTER_RETRY_DELAY_MS=

# AI classification (optional; heuristic path runs without it). One
# OpenAI-compatible chat-completions endpoint per batch — see
# src/lib/pipeline/classifier-cli.ts and docs/collector.md.
CLASSIFIER_BASE_URL=
CLASSIFIER_API_KEY=
CLASSIFIER_MODEL=

# Optional origin for public API cross-origin requests. The default permits all origins.
POLICAI_CORS_ORIGIN=

# Optional API base URL for the public MCP server. The default is https://policai.org.
POLICAI_API_BASE_URL=

# Optional directory of analysis pieces for previews. The default is data/articles.
POLICAI_ARTICLES_DIR=
