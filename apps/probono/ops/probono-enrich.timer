[Unit]
Description=Run Pro Bono Radar enrichment every 4 hours

[Timer]
# 00:20, 04:20, 08:20, 12:20, 16:20, 20:20 Sydney. Offset off the hour so it
# does not land on the 06:00 ingest, which runs its own pass at the end; the
# lock in enrich.sh is the real guard, this just avoids a pointless skip.
OnCalendar=*-*-* 00/4:20:00 Australia/Sydney
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
