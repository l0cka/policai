{
  "type": "object",
  "additionalProperties": false,
  "required": ["enrichments"],
  "properties": {
    "enrichments": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "stream",
          "relevant",
          "blurb",
          "opportunity",
          "opportunity_reason",
          "entities",
          "excerpt"
        ],
        "properties": {
          "item_id": {
            "type": "integer",
            "minimum": 1
          },
          "stream": {
            "type": "string",
            "enum": ["news", "law_reform", "funding", "tech_justice"]
          },
          "relevant": {
            "type": "boolean"
          },
          "blurb": {
            "type": "string",
            "minLength": 20,
            "maxLength": 600
          },
          "opportunity": {
            "type": "boolean"
          },
          "opportunity_reason": {
            "type": ["string", "null"],
            "maxLength": 300
          },
          "entities": {
            "type": "object",
            "additionalProperties": false,
            "required": ["organisations", "deadlines", "amounts"],
            "properties": {
              "organisations": {
                "type": "array",
                "items": { "type": "string" }
              },
              "deadlines": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["date", "label"],
                  "properties": {
                    "date": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "label": { "type": "string" },
                    "kind": {
                      "type": "string",
                      "enum": ["action", "milestone"]
                    }
                  }
                }
              },
              "amounts": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "excerpt": {
            "type": ["string", "null"],
            "maxLength": 700
          }
        }
      }
    }
  }
}
