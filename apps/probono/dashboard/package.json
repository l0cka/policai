{
  "name": "probono-radar-dashboard",
  "private": true,
  "scripts": {
    "dev": "next dev -p 8850",
    "build": "next build",
    "start": "next start",
    "predev": "mkdir -p public/maplibre && cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs node_modules/maplibre-gl/dist/maplibre-gl-shared.mjs public/maplibre/",
    "prebuild": "mkdir -p public/maplibre && cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs node_modules/maplibre-gl/dist/maplibre-gl-shared.mjs public/maplibre/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "maplibre-gl": "^6.4.1",
    "next": "^15.5.24",
    "pg": "^8.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23"
    }
  },
  "dependencyOverrideNotes": {
    "next>postcss": "Next 15.5.24 pins vulnerable PostCSS 8.4.31. Use same-major 8.5.23 to fix GHSA-qx2v-qp2m-jg93, GHSA-6g55-p6wh-862q, GHSA-fxqj-rqcc-2cmp and GHSA-r28c-9q8g-f849. Scoped to Next only; remove once Next declares a patched PostCSS. Sharp and Nanoid are updated within upstream ranges in package-lock.json, without overrides."
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.6",
    "@types/react": "^19.0.0",
    "typescript": "^5.5.4"
  }
}
